ONIONMAIL_NICK=onionmail
# Optional overrides for the sysop mailbox passwords (random if unset):
# SYSOP_SMTP_PASSWORD=
# SYSOP_POP3_PASSWORD=

# Use the Tor already running on the host instead of the container's tor.
# The host tor must publish the hidden service (see host_tor_setup.sh).
USE_HOST_TOR=1
ONION_ADDRESS=your-onion-address.onion
# Host tor SOCKS reachable from the container (127.0.0.1 with host networking):
TOR_IP=127.0.0.1
TOR_PORT=9050

ONIONMAIL_DISPLAY_NAME=example

# Address the local web front listens on.
# Keep 127.0.0.1 with host networking. For bridge networking with published
# ports (docker run -p 127.0.0.1:18000:18000) set this to 0.0.0.0.
WEB_BIND=127.0.0.1

# Optional: set to yes only while bootstrapping accounts (captcha is on by default).
# CAPTCHA_DISABLE=yes
